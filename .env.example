# Copy to .env and fill in. `source .env` (or the scripts auto-load it).

# --- OpenClaw runtime ----------------------------------------------------
# Random shared secret that pairs clients to the gateway. Generate with:
#   openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# --- Local Qwen model server ---------------------------------------------
MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
MODEL_PORT=8000
MODEL_DTYPE=bfloat16
# CPU thread count for torch (match your VM vCPUs on Brev).
OPENCLAW_CPU=4
MODEL_MAX_NEW_TOKENS=512

# --- Weave tracing (Weights & Biases) ------------------------------------
# Required for LLM call tracing. Create at https://wandb.ai/settings
WANDB_API_KEY=
WEAVE_PROJECT=openclaw-sandbox

# --- Other LLM providers (optional) --------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Local Docker (optional overrides) -----------------------------------
LOCAL_CONTAINER=openclaw-local
LOCAL_IMAGE=openclaw-local
OPENCLAW_PORT=18789
