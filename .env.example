# Copy to .env and fill in. `source .env` (or the scripts auto-load it).

# --- OpenClaw runtime ----------------------------------------------------
# Random shared secret that pairs clients to the gateway. Generate with:
#   openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# --- Hugging Face Inference Providers ----------------------------------
# Token with "Inference Providers" permission: https://huggingface.co/settings/tokens
HF_TOKEN=
# Provider for InferenceClient (see https://huggingface.co/docs/inference-providers).
HF_MODEL_PROVIDER=featherless-ai
MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
MODEL_PORT=8000
MODEL_MAX_NEW_TOKENS=512

# --- Weave / Weights & Biases tracing (OPTIONAL) -------------------------
# weave.init() + InferenceClient auto-tracing per:
# https://docs.wandb.ai/weave/guides/integrations/huggingface
WANDB_API_KEY=
WEAVE_PROJECT=openclaw-sandbox

# --- Local Docker (optional overrides) -----------------------------------
LOCAL_CONTAINER=openclaw-local
LOCAL_IMAGE=openclaw-local
OPENCLAW_PORT=18789
