# Copy to .env on the Brev instance and fill in the required secrets.
#
# This project currently uses Hugging Face Inference Providers for inference.
# The Brev GPU is not used by this configuration.

# --- OpenClaw runtime ----------------------------------------------------
# Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# --- Hugging Face Inference Providers ----------------------------------
# Token with "Inference Providers" permission:
# https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL_PROVIDER=featherless-ai
MODEL_ID=Qwen/Qwen2.5-7B-Instruct
MODEL_PORT=8000
MODEL_MAX_NEW_TOKENS=512

# --- Weave / Weights & Biases tracing (optional) ------------------------
WANDB_API_KEY=
WEAVE_PROJECT=openclaw-sandbox

# --- Docker runtime on Brev ---------------------------------------------
LOCAL_CONTAINER=openclaw-brev
LOCAL_IMAGE=openclaw-brev
OPENCLAW_PORT=18789
