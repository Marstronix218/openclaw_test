# Copy to .env and fill in. `source .env` (or the scripts auto-load it).

# --- OpenClaw runtime ----------------------------------------------------
# Random shared secret that pairs clients to the gateway. Generate with:
#   openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# LLM provider credential (OPTIONAL). You chose to configure the model/auth
# interactively via `openclaw onboard` inside the sandbox, so these can stay
# blank. If you do fill one in, it's passed into the sandbox env so the wizard
# can auto-detect it.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Weave / Weights & Biases tracing (OPTIONAL) -------------------------
# Set WANDB_API_KEY to stream every LLM call (prompts, completions, tool calls,
# token usage) from the model server to Weave. Get a key at
# https://wandb.ai/authorize. Leave blank to disable tracing entirely.
WANDB_API_KEY=
# Weave project to log to, as "entity/project" or just "project".
WEAVE_PROJECT=openclaw-sandbox

# --- Local Docker (optional overrides) -----------------------------------
LOCAL_CONTAINER=openclaw-local
LOCAL_IMAGE=openclaw-local
OPENCLAW_PORT=18789
