# Brev A100 80GB: local Qwen2.5-7B served by vLLM.
# Copy to .env.brev on the Brev instance and fill the gateway token.

OPENCLAW_GATEWAY_TOKEN=

# Public model; HF_TOKEN is optional but avoids anonymous Hub rate limits.
HF_TOKEN=
MODEL_ID=Qwen/Qwen2.5-7B-Instruct

# Isolated containers, network, ports, and persistent host data.
BREV_OPENCLAW_CONTAINER=openclaw-brev-qwen25-7b
BREV_VLLM_CONTAINER=vllm-brev-qwen25-7b
BREV_DOCKER_NETWORK=openclaw-brev-qwen25-7b
BREV_OPENCLAW_IMAGE=openclaw-brev:latest
BREV_VLLM_IMAGE=vllm/vllm-openai:v0.11.0
BREV_DATA_DIR=.brev-data
OPENCLAW_PORT=18789
VLLM_HOST_PORT=8000

# Single NVIDIA A100 80GB.
GPU_DEVICE=0
VLLM_DTYPE=bfloat16
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=16

# Pin this for a fully repeatable comparison.
BREV_OPENCLAW_VERSION=latest

# Optional: enables OpenClaw's web_search tool.
BRAVE_API_KEY=

# Stable benchmark identity/session.
BENCHMARK_USER=alice
BENCHMARK_SESSION_KEY=openclaw-qwen25-7b-alice
